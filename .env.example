# Anthropic API key — used for unattended query() calls (do NOT use an interactive
# `claude login` OAuth session here; this process runs headless in the background).
ANTHROPIC_API_KEY=

# Discord bot token from the Discord Developer Portal (Bot tab).
DISCORD_BOT_TOKEN=

# Your Discord user ID (enable Developer Mode in Discord, right-click your name -> Copy User ID).
# Every message from any other user is silently ignored — this is what makes ev-claw single-user.
OWNER_DISCORD_ID=

# Path to the SQLite database file.
DB_PATH=./data/ev-claw.db

# Directory the agent's Write/Edit tools are allowed to touch.
EV_CLAW_WORKSPACE_DIR=~/ev-claw-workspace

# Model to use for query() calls. Pin explicitly rather than relying on SDK defaults.
EV_CLAW_MODEL=claude-sonnet-5
